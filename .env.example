APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# 用 Docker 部署时（见 README「生产环境部署（Docker）」）PostgreSQL 装在宿主机上，这里要改成 host.docker.internal
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=honsen_drawing
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# 生产环境（HTTPS）务必设为 true，否则 Cookie 会以明文 HTTP 传输
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# 腾讯云 COS（生产环境把 FILESYSTEM_DISK 切换为 cos）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_APP_ID=
COS_REGION=ap-guangzhou
# 可选：配置了全球加速等自定义域名时，SDK 直接用这个域名，COS_REGION 仅作兜底
COS_DOMAIN=
COS_SIGN_URL_TTL=600
COS_STS_ROLE_ARN=
COS_STS_DURATION=1800

# ODA File Converter（免费工具，DWG→DXF，用于浏览器交互式看图）
ODA_CONVERTER_PATH=
# 部署到 Linux 服务器时必须设为 true，并 sudo apt install xvfb
ODA_USE_XVFB=false

# 登录验证码（mews/captcha，纯本地生成，不依赖任何外部服务）
CAPTCHA_DISABLE=false

VITE_APP_NAME="${APP_NAME}"
